# ── Database (Supabase Postgres) ──────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://user:pass@host:5432/postgres?sslmode=require"

# ── App ───────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
AUTH_SECRET="dev-secret-change-me"

# ── LLM (Gemini Flash default) ────────────────────────────────────
LLM_PROVIDER="mock"                # mock | gemini
LLM_MODEL="gemini-2.5-flash"       # gemini-2.0-flash is shut down (404)
GEMINI_API_KEY=""

# ── Chess engine ──────────────────────────────────────────────────
ENGINE_KIND="mock"                 # mock | native | wasm
STOCKFISH_PATH="/usr/local/bin/stockfish"
ENGINE_MOVETIME_MS="150"

# ── Game source ───────────────────────────────────────────────────
GAME_SOURCE="mock"                 # mock | lichess
LICHESS_USER_AGENT="ChessCoachMVP/0.1 (contact: you@example.com)"
MAX_GAMES_PER_JOB="30"
MAX_EXAMPLES_PER_WEAKNESS="10"

# ── Analytics / email / monitoring ────────────────────────────────
ANALYTICS_PROVIDER="mock"          # mock | posthog
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
MAILER_PROVIDER="mock"             # mock | resend
RESEND_API_KEY=""
EMAIL_FROM="Chess Coach <noreply@example.com>"
SENTRY_DSN=""

# ── Worker ────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS="2000"
