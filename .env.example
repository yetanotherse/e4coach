# ── Database (Supabase Postgres) ──────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://user:pass@host:5432/postgres?sslmode=require"

# ── App ───────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
AUTH_SECRET="dev-secret-change-me"

# ── LLM (Gemini Flash default) ────────────────────────────────────
LLM_PROVIDER="mock"                # mock | gemini
LLM_MODEL="gemini-2.5-flash"       # gemini-2.0-flash is shut down (404)
GEMINI_API_KEY=""

# ── Chess engine ──────────────────────────────────────────────────
ENGINE_KIND="mock"                 # mock | native | wasm
STOCKFISH_PATH="/usr/local/bin/stockfish"
ENGINE_DEPTH="12"                  # fixed search depth → deterministic, reproducible analysis
ENGINE_MOVETIME_MS="150"           # non-deterministic time-budget fallback (used only if no depth)

# ── Deep analysis (move explanations) ─────────────────────────────
# A second, deeper MultiPV pass over ONLY the mistakes shown in the report, used
# to explain WHY the engine's move was better (refutation line + alternatives)
# instead of just naming it. Adds ~30-90s per job, so it is off by default.
DEEP_ANALYSIS_ENABLED="false"      # true to enable richer move explanations
DEEP_ANALYSIS_DEPTH="20"           # deeper than ENGINE_DEPTH — these lines are shown to users
DEEP_ANALYSIS_MULTIPV="3"          # engine's choice + 2 alternatives that also held
DEEP_ANALYSIS_MAX_POSITIONS="40"   # hard cap; the only real bound on this stage's runtime
DEEP_ANALYSIS_PV_PLIES="6"         # plies of each variation kept for the stepper

# Studies import uses per-user OAuth (PKCE) — no server token required.
# LICHESS_API_TOKEN is unused by the app; kept only for manual API diagnostics.
LICHESS_API_TOKEN=""

# ── Game source ───────────────────────────────────────────────────
GAME_SOURCE="mock"                 # mock | lichess (studies use OAuth, per-job)
LICHESS_USER_AGENT="ChessCoachMVP/0.1 (contact: you@example.com)"
MAX_GAMES_PER_JOB="30"             # live-fetch cap (recent games)
MAX_ANALYZED_GAMES="50"            # cap for pre-stored sources (studies)
MAX_EXAMPLES_PER_WEAKNESS="10"

# ── Analytics / email / monitoring ────────────────────────────────
ANALYTICS_PROVIDER="mock"          # mock | posthog
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
MAILER_PROVIDER="mock"             # mock | resend
RESEND_API_KEY=""
EMAIL_FROM="Chess Coach <noreply@example.com>"
SENTRY_DSN=""

# ── Billing (plans/phase-2.md 2.5 — stubs only, gateway deferred) ──
BILLING_PROVIDER="mock"            # mock (real gateway TBD: stripe/paddle/…)

# ── Rate limiting (plans/phase-2.md 2.0.5, DB-backed per-IP fixed windows) ──
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_AUTH_PER_MIN="10"       # auth/request + otp/request + otp/verify
RATE_LIMIT_SIGNUP_PER_MIN="10"
RATE_LIMIT_TRACK_PER_MIN="600"     # /api/track + /api/interest

# ── Worker ────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS="2000"
