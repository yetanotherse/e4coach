// Prisma schema — spec §10. Postgres on Supabase.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  // "native" covers local dev; "rhel-openssl-3.0.x" is Vercel's Lambda runtime
  // (and AWS Lambda generally). Both engines are emitted so the deployed bundle
  // has a matching query engine.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  emailHash    String?         // hashed email for analytics distinctId (spec §15)
  lichessUser  String?
  chessComUser String?
  consentAt    DateTime? // when the user accepted the privacy policy
  createdAt    DateTime        @default(now())
  lastSeenAt   DateTime        @default(now())
  analysisJobs AnalysisJob[]
  reports      Report[]
  interests    Interest[]
  authChallenges AuthChallenge[]
  drills       Drill[]
  trainingPlans TrainingPlan[]
  drillAttempts DrillAttempt[]
}

model AnalysisJob {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String // 'lichess' | 'lichess-study' | 'chesscom'
  status     JobStatus @default(PENDING)
  stage      String? // fine-grained progress for the UI
  gameCount  Int       @default(0)
  params     Json? // user-chosen selection: { maxGames, perfTypes }
  engineMeta Json? // { kind, version, depth/movetime }
  error      String?
  // idempotency / resumability: which pipeline stage outputs are persisted
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  report     Report?
  games      Game[] // pre-stored games (study/PGN sources); empty for live-fetch

  @@index([status, createdAt])
  @@index([userId])
}

// Pre-imported games for sources that aren't live-fetched at analysis time
// (Lichess studies, later PGN upload). Live sources (lichess/mock) don't use this.
model Game {
  id          String      @id @default(cuid())
  jobId       String
  job         AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  externalId  String // source game id (Lichess game id or study/chapter id)
  pgn         String // mainline PGN (analysis + in-app stepper)
  white       String
  black       String
  userColor   String // 'white' | 'black'
  result      String
  timeControl String
  speed       String?
  gameUrl     String?
  playedAt    DateTime
  createdAt   DateTime    @default(now())

  @@index([jobId])
}

model Report {
  id         String        @id @default(cuid())
  userId     String
  jobId      String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        AnalysisJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  publicSlug String        @unique // long random unguessable token (spec §11.2)
  profile    Json // structured WeaknessProfile (source of truth)
  content    Json // rendered ReportContent (LLM prose + example refs)
  degraded   Boolean       @default(false) // produced by template fallback?
  createdAt  DateTime      @default(now())
  viewCount  Int           @default(0)
  trainingPlans TrainingPlan[]

  @@index([userId])
}

// Fake-door willingness-to-pay signal (spec §13 POST /api/interest, §15)
model Interest {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String? // waitlist contact — from the report user or the homepage form
  tier      String
  createdAt DateTime @default(now())

  @@index([tier])
}

enum JobStatus {
  PENDING
  FETCHING
  EVALUATING
  CLASSIFYING
  GENERATING
  DONE
  FAILED
}

// Passwordless sign-in challenges (plans/phase-2.md 2.0). Only OTP for now;
// magic links stay stateless HMAC tokens in apps/web/lib/token.ts. The code is
// never stored in plaintext — only an HMAC of it, so a DB leak can't sign in.
model AuthChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // 'otp'
  codeHash   String // HMAC-SHA256(secret, email + code) hex
  attempts   Int       @default(0) // verify attempts; exhausted => challenge dead
  expiresAt  DateTime
  consumedAt DateTime? // set when verified; a used challenge can't replay
  createdAt  DateTime  @default(now())

  @@index([userId, kind])
}

// DB-backed fixed-window rate limiting (plans/phase-2.md 2.0.5). One row per
// bucket; the window rolls via an atomic upsert in lib/rateLimit.ts.
model RateLimitBucket {
  bucket      String   @id // e.g. "auth_request:1.2.3.4"
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
}

// ── Training plans & drills (plans/phase-2.md 2.2a) ─────────────────────────
// One plan per user per week, generated from a report's WeaknessProfile.
// Re-analysis in the same week supersedes the earlier plan (status field),
// while drills — owned by the user — survive via dedupe so 2.3's spaced
// repetition can schedule them across weeks.

model TrainingPlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceReportId String?
  report         Report?  @relation(fields: [sourceReportId], references: [id], onDelete: SetNull)
  weekStart      DateTime // Monday 00:00 UTC of this plan's week
  // 'active' | 'superseded' - a new plan for the same week takes over.
  status         String   @default("active")
  createdAt      DateTime @default(now())
  items          PlanItem[]

  @@index([userId, weekStart])
  @@index([userId, status])
}

// One focus theme within a plan, with its coach-voiced goal for the week.
model PlanItem {
  id     String       @id @default(cuid())
  planId String
  plan   TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  theme  String // WeaknessCategory id
  goal   String // this week's goal prose (template or LLM-phrased)
  drills Drill[]

  @@index([planId])
}

// A position to re-solve: from the user's own games (2.2a) or the puzzle DB
// (2.2b). Owned directly by the user (NOT by a plan) so a drill can recur in
// later weeks' plans and carry its own attempt/scheduling history.
model Drill {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String         @default("own_game") // own_game | puzzle (2.2b)
  theme         String // WeaknessCategory id
  fen           String // position BEFORE the mistake — the user's move to find
  sideToMove    String // 'white' | 'black' (== the user's color in the game)
  solutionUci   String // engine's better move (UCI)
  solutionSan   String?
  playedMoveSan String? // what the user actually played (revealed feedback)
  gameId        String? // source game id (ties to the report example)
  puzzleId      String? // Lichess puzzle id (type = 'puzzle', plans/phase-2.md 2.2b)
  note          String? // deterministic factual note from the report
  attempts      DrillAttempt[]
  planItems     PlanItem[]
  createdAt     DateTime       @default(now())

  @@index([userId, theme])
}

// Every solve attempt, for progress display (2.2a) and SRS scheduling (2.3).
model DrillAttempt {
  id          String   @id @default(cuid())
  drillId     String
  drill       Drill    @relation(fields: [drillId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  solved      Boolean
  playedUci   String? // what the user tried this attempt
  timeSpentMs Int?
  createdAt   DateTime @default(now())

  @@index([drillId])
  @@index([userId])
}

// Lichess puzzle DB slice (plans/phase-2.md 2.2b), ingested by the theme-mapped
// script in apps/worker/scripts. Populated at deploy time, read by plan
// generation to mix thematic master-position drills into weekly plans.
model Puzzle {
  id          String   @id @default(cuid())
  externalId  String   @unique // Lichess puzzle id
  fen         String   // start position; the side to move solves
  solutionUci String   // first move of the solution line (UCI)
  line        String   // full solution line (UCI, space-separated)
  rating      Int      // puzzle difficulty (approx. playing strength)
  themes      String // space-separated Lichess theme tags (raw, for debugging)
  category    String // mapped WeaknessCategory
  createdAt   DateTime @default(now())

  @@index([category, rating])
}

// Engine-eval cache (plans/phase-2.md 2.2b): fixed-depth evals are
// deterministic, so (fen, depth, kind) -> eval is safe to persist across jobs.
model EvalCache {
  fen      String
  depth    Int
  kind     String // engine kind (adapter name) — evals differ per engine
  evalJson Json // EngineEval
  createdAt DateTime @default(now())

  @@id([fen, depth, kind])
}
